{
  "name": "nodejs-solid",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch './**/*.ts' --exec 'tsx' ./src/index.ts",
    "migrate:up": "npx sequelize-cli db:migrate",
    "migrate:down": "npx sequelize-cli db:migrate:undo",
    "seed:up": "npx sequelize-cli db:seed:all",
    "seed:down": "npx sequelize-cli --config config/config.js db:seed:undo:all",
    "clean": "rimraf dist/",
    "build": "npm run clean && tsc",
    "start": "npm run build && nodemon dist/index.js",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.3.0",
    "express": "^5.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pdfmake": "^0.3.14",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.32.0",
    "sequelize-cli": "^6.6.1",
    "sequelize-typescript": "^2.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
