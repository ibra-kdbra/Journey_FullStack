# Copy to .env (never commit .env).
# Use True only for local development; the app defaults to False.
DEBUG=False

# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Comma separated hosts / origins for your deployment
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# SQLite path (the Docker image defaults to /data/db.sqlite3 on a volume)
# SQLITE_PATH=/data/db.sqlite3

# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_NAME=appseed_db
# DB_USERNAME=appseed_db_usr
# DB_PASS=pass
# DB_PORT=3306
