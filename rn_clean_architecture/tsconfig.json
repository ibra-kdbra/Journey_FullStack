{
  // @react-native/typescript-config was installed but never extended, so this
  // file restated a partial, drifting copy of it. That is why `tsc` could not
  // run at all: it kept `moduleResolution: "node"` and `baseUrl`, both removed
  // in TypeScript 7, while the base config already sets `bundler`, skipLibCheck
  // and `types: ["jest"]`.
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "experimentalDecorators": true,
    // TypeScript 7 no longer honours the base config's `jsx: "react-native"`.
    // `preserve` is what that mode always meant - emit the JSX untouched and
    // let Metro's Babel transform handle it.
    "jsx": "preserve",
    // Relative to this file. TS 7 removed baseUrl; these mirror the
    // module-resolver roots in babel.config.js.
    "paths": {
      "*": ["./app/*"],
      "@common/*": ["./app/common/*"],
      "@data/*": ["./app/data/*"],
      "@domain/*": ["./app/domain/*"],
      "@presentation/*": ["./app/presentation/*"],
      "@di/*": ["./app/di/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
