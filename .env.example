# Runtime
NODE_ENV=
ENV=
AIRCITY_PROCESS_API_PORT=

# Auth: bearer tokens are Firebase ID tokens, verified (incl. revocation) with the
# firebase-admin app initialised from FB_CONFIG below.

# Scheduler endpoints (POST /notifications/cronjob/send-message) require this
# secret in the x-cron-secret header (or Authorization: Bearer). If unset the
# endpoint rejects every request.
CRON_SECRET=

# Twilio (JSON: twilio_account_sid, twilio_auth_token, twilio_phone_number)
TWILIO_KEY=
# Public URL Twilio posts incoming messages to; used to verify X-Twilio-Signature
TWILIO_WEBHOOK_URL=

# All four are required; the app refuses to start if any is empty.
MYSQLDB_HOST=
MYSQLDB_PORT=
MYSQLDB_USER=
MYSQLDB_PASSWORD=
MYSQLDB_NAME=
FB_CONFIG=
AWS_KEY=
AWS_BUCKET_NAME=
