# Environment variables read by app/config.py. Copy to .env (git-ignored) and fill in.
# In production (ProdConfig) the four values marked REQUIRED must be set to real
# secrets; the API refuses to start if they are missing or equal to a dev default.
# Development and tests (DevConfig/TestConfig) fall back to insecure dev defaults.

# REQUIRED in production: signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MY_SOLID_APP_SECRET_KEY=
# REQUIRED in production: encrypts stored TOTP secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MY_SOLID_APP_FERNET_SECRET_KEY=
# REQUIRED in production
MY_SOLID_APP_DB_PASSWORD=
# REQUIRED in production
MY_SOLID_APP_MAIL_PASSWORD=

MY_SOLID_APP_DB_NAME=
MY_SOLID_APP_DB_USER=
MY_SOLID_APP_DB_HOST=
MY_SOLID_APP_DB_PORT=
MY_SOLID_APP_REDIS_HOST=
MY_SOLID_APP_MAIL_SERVER=
MY_SOLID_APP_MAIL_PORT=
MY_SOLID_APP_MAIL_USE_SSL=
MY_SOLID_APP_MAIL_USERNAME=
MY_SOLID_APP_MAIL_DEFAULT_SENDER=
MY_SOLID_APP_FRONTEND_URL=
MY_SOLID_APP_PASSWORD_RESET_TOKEN_EXPIRE_HOURS=
MY_SOLID_APP_FILE_LOGGING=

# Rate limiting (optional). Storage defaults to redis://$MY_SOLID_APP_REDIS_HOST
MY_SOLID_APP_RATELIMIT_STORAGE_URI=
MY_SOLID_APP_LOGIN_RATE_LIMIT=
MY_SOLID_APP_LOGIN_ACCOUNT_RATE_LIMIT=
MY_SOLID_APP_PASSWORD_RESET_RATE_LIMIT=
MY_SOLID_APP_MAX_2FA_ATTEMPTS=
# Number of reverse proxies in front of the API (1 behind the bundled nginx)
MY_SOLID_APP_TRUSTED_PROXY_COUNT=
