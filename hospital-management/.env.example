# Environment variables read by the hospital-management services.
# Export them (or use your IDE/run configuration); values here are intentionally empty.

# patient-service: database
DB_USER=
DB_PASSWORD=
# Optional, defaults to jdbc:postgresql://localhost:5432/hospital_patient_db
DB_URL=

# HTTP Basic credentials clients use for the gateway and patient-service.
HOSPITAL_API_USER=
HOSPITAL_API_PASSWORD=

# HTTP Basic credentials of the Eureka registry (discovery-server). Clients
# (gateway, patient-service) embed them in their registration URL.
EUREKA_USER=
EUREKA_PASSWORD=
# Optional, defaults to localhost
EUREKA_HOST=
