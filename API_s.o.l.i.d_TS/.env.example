# Copy to .env and fill in. Connection details used to live in ormconfig.json,
# which meant they were committed to the repository.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rentx

# Secret used to sign and verify login tokens. Required: the server refuses to
# start without it. Use a random value of at least 32 characters, e.g.
# `openssl rand -hex 32`. Never commit the real value.
JWT_SECRET=
