{
    "name": "api-solid-ts",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "dev": "ts-node-dev --transpile-only --ignore-watch node_modules --respawn src/shared/infra/http/server.ts",
        "lint": "eslint \"src/**/*.ts\"",
        "migration:revert": "npm run typeorm -- migration:revert",
        "migration:run": "npm run typeorm -- migration:run",
        "seed:admin": "ts-node-dev src/shared/infra/typeorm/seed/admin.ts",
        "test": "jest",
        "typeorm": "typeorm-ts-node-commonjs -d ./src/shared/infra/typeorm/index.ts"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/supertest": "^7.2.0",
        "@types/swagger-ui-express": "^4.1.3",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-import-helpers": "^2.0.1",
        "eslint-plugin-prettier": "^5.0.0",
        "globals": "^17.3.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.53.1"
    },
    "dependencies": {
        "@types/multer": "^2.0.0",
        "bcrypt": "^6.0.0",
        "csv-parse": "^7.0.0",
        "dayjs": "^1.11.10",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.0",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.0",
        "tsyringe": "^4.8.0",
        "typeorm": "1.1.0"
    }
}
